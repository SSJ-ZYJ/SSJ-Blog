---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import { url } from "../../utils/url-utils";

interface Props {
	class?: string;
	headings: MarkdownHeading[];
}

const { headings = [], class: className } = Astro.props;

let minDepth = 10;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}

const isPostsRoute = Astro.url.pathname.startsWith(url("/posts/"));

const removeTailingHash = (text: string) => {
	let lastIndexOfHash = text.lastIndexOf("#");
	if (lastIndexOfHash !== text.length - 1) {
		return text;
	}

	return text.substring(0, lastIndexOfHash);
};

let heading1Count = 1;

const maxLevel = siteConfig.toc.depth;
---
{isPostsRoute &&
<table-of-contents class:list={[className, "group"]}>
    {headings.filter((heading) => heading.depth < minDepth + maxLevel).map((heading) =>
            <a href={`#${heading.slug}`} class="px-2 flex gap-2 relative transition w-full min-h-9 rounded-xl
        hover:bg-[var(--toc-btn-hover)] active:bg-[var(--toc-btn-active)] py-2
    ">
                <div class:list={["transition w-5 h-5 shrink-0 rounded-lg text-xs flex items-center justify-center font-bold",
                    {
                        "bg-[var(--toc-badge-bg)] text-[var(--btn-content)]": heading.depth == minDepth,
                        "ml-4": heading.depth == minDepth + 1,
                        "ml-8": heading.depth == minDepth + 2,
                    }
                ]}
                >
                    {heading.depth == minDepth && heading1Count++}
                    {heading.depth == minDepth + 1 && <div class="transition w-2 h-2 rounded-[0.1875rem] bg-[var(--toc-badge-bg)]"></div>}
                    {heading.depth == minDepth + 2 && <div class="transition w-1.5 h-1.5 rounded-sm bg-black/5 dark:bg-white/10"></div>}
                </div>
                <div class:list={["transition text-sm", {
                    "text-50": heading.depth == minDepth || heading.depth == minDepth + 1,
                    "text-30": heading.depth == minDepth + 2,
                }]}>{removeTailingHash(heading.text)}</div>
            </a>
    )}
    <div id="active-indicator" style="opacity: 0" class:list={[{'hidden': headings.length == 0}, "-z-10 absolute bg-[var(--toc-btn-hover)] left-0 right-0 rounded-xl transition-all " +
        "group-hover:bg-transparent border-2 border-[var(--toc-btn-hover)] group-hover:border-[var(--toc-btn-active)] border-dashed"]}></div>
</table-of-contents>}

<script>
class TOCStateManager {
    private headingIdxMap = new Map<string, number>();
    private headings: HTMLElement[] = [];
    private sections: HTMLElement[] = [];
    private tocEntries: HTMLAnchorElement[] = [];
    private active: boolean[] = [];

    constructor(entries: HTMLAnchorElement[]) {
        this.tocEntries = entries;
        this.initializeMappings();
    }

    private initializeMappings() {
        this.sections = new Array(this.tocEntries.length);
        this.headings = new Array(this.tocEntries.length);
        this.active = new Array(this.tocEntries.length).fill(false);

        for (let i = 0; i < this.tocEntries.length; i++) {
            const id = decodeURIComponent(this.tocEntries[i].hash?.substring(1));
            const heading = document.getElementById(id);
            const section = heading?.parentElement;

            if (heading instanceof HTMLElement && section instanceof HTMLElement) {
                this.headings[i] = heading;
                this.sections[i] = section;
                this.headingIdxMap.set(id, i);
            }
        }
    }

    getSections(): HTMLElement[] {
        return this.sections.filter(Boolean) as HTMLElement[];
    }

    getHeadings(): HTMLElement[] {
        return this.headings.filter(Boolean) as HTMLElement[];
    }

    getHeading(idx: number): HTMLElement | undefined {
        return this.headings[idx];
    }

    setActive(idx: number, value: boolean) {
        if (idx >= 0 && idx < this.active.length) {
            this.active[idx] = value;
        }
    }

    getActive(): boolean[] {
        return [...this.active];
    }

    getIdxById(id: string): number | undefined {
        return this.headingIdxMap.get(id);
    }

    getEntryByIndex(idx: number): HTMLAnchorElement | undefined {
        return this.tocEntries[idx];
    }

    getEntries(): HTMLAnchorElement[] {
        return [...this.tocEntries];
    }

    getActiveEntries(): HTMLAnchorElement[] {
        return this.tocEntries.filter((_, i) => this.active[i]);
    }
}

class TOCScrollDetector {
    private observer: IntersectionObserver;

    constructor(
        sections: HTMLElement[],
        onVisibilityChange: (entries: IntersectionObserverEntry[]) => void
    ) {
        this.observer = new IntersectionObserver(onVisibilityChange, { threshold: 0 });
        sections.forEach((section) => this.observer.observe(section));
    }

    disconnect() {
        this.observer.disconnect();
    }
}

class TOCUIUpdater {
    private visibleClass = "visible";
    private activeIndicator: HTMLElement | null = null;
    private tocEl: HTMLElement | null = null;

    constructor(tocEl: HTMLElement | null) {
        this.tocEl = tocEl;
        this.activeIndicator = document.getElementById("active-indicator");
    }

    updateActiveState(entries: HTMLAnchorElement[], active: boolean[]) {
        let i = active.length - 1;
        let min = active.length - 1, max = -1;

        while (i >= 0 && !active[i]) {
            entries[i]?.classList.remove(this.visibleClass);
            i--;
        }

        while (i >= 0 && active[i]) {
            entries[i]?.classList.add(this.visibleClass);
            min = Math.min(min, i);
            max = Math.max(max, i);
            i--;
        }

        while (i >= 0) {
            entries[i]?.classList.remove(this.visibleClass);
            i--;
        }

        this.updateIndicator(entries, min, max);
    }

    private updateIndicator(entries: HTMLAnchorElement[], min: number, max: number) {
        if (min > max || !this.activeIndicator || !this.tocEl) {
            this.activeIndicator?.setAttribute("style", "opacity: 0");
            return;
        }

        const parentOffset = this.tocEl.getBoundingClientRect().top;
        const scrollOffset = this.tocEl.scrollTop;
        const top = entries[min].getBoundingClientRect().top - parentOffset + scrollOffset;
        const bottom = entries[max].getBoundingClientRect().bottom - parentOffset + scrollOffset;

        this.activeIndicator.setAttribute("style", `top: ${top}px; height: ${bottom - top}px`);
    }

    scrollToActive(entries: HTMLAnchorElement[], active: boolean[]) {
        if (!this.tocEl || !entries.length) return;

        const activeEntries = entries.filter((_, i) => active[i]);
        if (!activeEntries.length) return;

        const topmost = activeEntries[0];
        const bottommost = activeEntries[activeEntries.length - 1];
        const tocHeight = this.tocEl.clientHeight;

        let top;
        if (bottommost.getBoundingClientRect().bottom -
            topmost.getBoundingClientRect().top < 0.9 * tocHeight) {
            top = topmost.offsetTop - 32;
        } else {
            top = bottommost.offsetTop - tocHeight * 0.8;
        }

        this.tocEl.scrollTo({
            top,
            left: 0,
            behavior: "smooth",
        });
    }
}

class TableOfContents extends HTMLElement {
    private stateManager: TOCStateManager | null = null;
    private scrollDetector: TOCScrollDetector | null = null;
    private uiUpdater: TOCUIUpdater | null = null;
    private anchorNavTarget: HTMLElement | null = null;

    constructor() {
        super();
    }

    connectedCallback() {
        this.waitForAnimationAndInit();
    }

    private waitForAnimationAndInit() {
        const element = document.querySelector(".prose");
        if (element) {
            const computedStyle = window.getComputedStyle(element);
            const hasAnimation = computedStyle.animationName && computedStyle.animationName !== "none";

            if (hasAnimation) {
                element.addEventListener("animationend", () => {
                    this.init();
                }, { once: true });

                setTimeout(() => {
                    if (!this.stateManager) {
                        this.init();
                    }
                }, 1500);
            } else {
                this.init();
            }
        } else {
            setTimeout(() => this.init(), 100);
        }
    }

    private init() {
        const tocEl = document.getElementById("toc-inner-wrapper");
        if (!tocEl) return;

        const tocEntries = Array.from(
            document.querySelectorAll<HTMLAnchorElement>("#toc a[href^='#']")
        );

        if (tocEntries.length === 0) return;

        this.stateManager = new TOCStateManager(tocEntries);
        this.uiUpdater = new TOCUIUpdater(tocEl);

        this.scrollDetector = new TOCScrollDetector(
            this.stateManager.getSections(),
            this.handleVisibilityChange.bind(this)
        );

        tocEl.addEventListener("click", this.handleAnchorClick.bind(this), {
            capture: true,
        });

        this.performFallback();
        this.updateUI();
    }

    private handleVisibilityChange(entries: IntersectionObserverEntry[]) {
        entries.forEach((entry) => {
            const id = entry.target.children[0]?.getAttribute("id");
            const idx = id ? this.stateManager?.getIdxById(id) : undefined;

            if (idx !== undefined) {
                this.stateManager?.setActive(idx, entry.isIntersecting);
            }

            if (entry.isIntersecting && this.anchorNavTarget === entry.target.firstChild) {
                this.anchorNavTarget = null;
            }
        });

        const active = this.stateManager?.getActive() || [];
        if (!active.includes(true)) {
            this.performFallback();
        }
        this.updateUI();
    }

    private performFallback() {
        const sections = this.stateManager?.getSections() || [];
        for (let i = 0; i < sections.length; i++) {
            const offsetTop = sections[i].getBoundingClientRect().top;
            const offsetBottom = sections[i].getBoundingClientRect().bottom;

            if (this.isInRange(offsetTop, 0, window.innerHeight) ||
                this.isInRange(offsetBottom, 0, window.innerHeight) ||
                (offsetTop < 0 && offsetBottom > window.innerHeight)) {
                this.stateManager?.setActive(i, true);
            } else if (offsetTop > window.innerHeight) {
                break;
            }
        }
    }

    private updateUI() {
        requestAnimationFrame(() => {
            const entries = this.stateManager?.getEntries() || [];
            const active = this.stateManager?.getActive() || [];

            this.uiUpdater?.updateActiveState(entries, active);
            if (!this.anchorNavTarget) {
                this.uiUpdater?.scrollToActive(entries, active);
            }
        });
    }

    private handleAnchorClick(event: Event) {
        const anchor = event.composedPath().find(
            (element) => element instanceof HTMLAnchorElement
        ) as HTMLAnchorElement;

        if (anchor) {
            const id = decodeURIComponent(anchor.hash?.substring(1));
            const idx = this.stateManager?.getIdxById(id);

            if (idx !== undefined) {
                this.anchorNavTarget = this.stateManager?.getHeading(idx) || null;
            } else {
                this.anchorNavTarget = null;
            }
        }
    }

    private isInRange(value: number, min: number, max: number) {
        return min < value && value < max;
    }

    disconnectedCallback() {
        this.scrollDetector?.disconnect();
        const tocEl = document.getElementById("toc-inner-wrapper");
        tocEl?.removeEventListener("click", this.handleAnchorClick.bind(this));
    }
}

if (!customElements.get("table-of-contents")) {
    customElements.define("table-of-contents", TableOfContents);
}
</script>